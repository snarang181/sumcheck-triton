 namespace mlir::triton::gpu {
+const llvm::SetVector<Operation *> &CoalesceSliceCache::get(Operation *op) {
+  auto it = index.find(op);
+  if (it != index.end())
+    return *slices[it->second];
+  slices.push_back(
+      std::make_unique<llvm::SetVector<Operation *>>(mlir::getSlice(op)));
+  unsigned id = slices.size() - 1;
+  for (Operation *member : *slices[id])
+    index.try_emplace(member, id);
+  index.try_emplace(op, id);
+  return *slices[id];
+}
