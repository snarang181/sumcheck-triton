+// Ablation knob: extra dynamic shared memory per eval block (bytes), which caps resident
+// blocks per SM and so lowers occupancy without changing the kernel's code or registers.
+// ZKDUEL_REPORT_OCCUPANCY=1 prints the achieved blocks/SM once per eval instantiation.
+static size_t eval_extra_smem() {
+  static const size_t v = [] {
+    const char* s = std::getenv("ZKDUEL_EVAL_EXTRA_SMEM");
+    return s ? static_cast<size_t>(std::strtoull(s, nullptr, 10)) : size_t{0};
+  }();
+  return v;
+}
